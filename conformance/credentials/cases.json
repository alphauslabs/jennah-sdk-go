{
  "suite": "client-credentials",
  "version": 1,
  "source": "jennah openspec/specs/client-credentials/spec.md",
  "cases": [
    {
      "id": "resolution/explicit-wins-over-environment-and-file",
      "requirement": "Credential resolution is ordered and first-match",
      "scenario": "An explicit credential wins over a stored session",
      "given": {
        "explicit": "jennah_sk_explicit",
        "env": "jennah_sk_env",
        "session": { "raw": "{ this is not a session" },
        "server": { "accept": "jennah_sk_explicit" }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "describe", "expect": { "kind": "api_key", "origin": "explicit" } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "presented": ["jennah_sk_explicit"] } }
      ]
    },
    {
      "id": "resolution/explicit-needs-no-file",
      "requirement": "Credential resolution is ordered and first-match",
      "scenario": "An explicit credential wins over a stored session",
      "given": {
        "explicit": "jennah_sk_explicit",
        "server": { "accept": "jennah_sk_explicit" }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "session": "absent" } }
      ]
    },
    {
      "id": "resolution/environment-wins-over-file",
      "requirement": "Credential resolution is ordered and first-match",
      "scenario": "An explicit credential wins over a stored session",
      "given": {
        "env": "jennah_sk_env",
        "session": { "raw": "{ this is not a session" },
        "server": { "accept": "jennah_sk_env" }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "describe", "expect": { "kind": "api_key", "origin": "environment" } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "presented": ["jennah_sk_env"] } }
      ]
    },
    {
      "id": "resolution/stored-session-when-nothing-else",
      "requirement": "Credential resolution is ordered and first-match",
      "scenario": "A stored session is used when nothing else is supplied",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_stored",
          "refresh_token": "rt_stored",
          "token_type": "Bearer",
          "expires_in": 3600
        },
        "server": { "accept": "at_stored" }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "describe", "expect": { "kind": "session", "origin": "file" } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "presented": ["at_stored"], "refreshes": 0 } }
      ]
    },
    {
      "id": "resolution/no-credential-is-a-construction-error",
      "requirement": "Credential resolution is ordered and first-match",
      "scenario": "No credential anywhere is a construction-time error",
      "given": {},
      "steps": [
        {
          "op": "construct",
          "expect": { "error": ["no_credential"], "mentions": ["jnh login", "JENNAH_API_KEY"] }
        }
      ]
    },
    {
      "id": "identity/explicit-access-token-is-a-session",
      "requirement": "A program can tell which credential authenticated it",
      "scenario": "A diagnostic reports the credential without leaking it",
      "given": { "explicit": "eyJ.explicit.token" },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "describe", "expect": { "kind": "session", "origin": "explicit" } }
      ]
    },
    {
      "id": "session/corrupt-file-is-reported-with-its-path",
      "requirement": "The stored session is a contract shared between clients",
      "scenario": "An unreadable session is reported, not ignored",
      "given": { "session": { "raw": "{ this is not a session" } },
      "steps": [
        {
          "op": "construct",
          "expect": { "error": ["corrupt_session"], "not": ["no_credential"], "mentions": ["$SESSION_PATH"] }
        }
      ]
    },
    {
      "id": "session/writes-are-atomic-and-owner-only",
      "requirement": "The stored session is a contract shared between clients",
      "scenario": "A concurrent reader never sees a half-written session",
      "given": {},
      "steps": [
        { "op": "atomic_replace", "writes": 200, "expect": { "partial_reads": 0 } },
        { "op": "check", "expect": { "session_mode": "0600", "dir_mode": "0700", "stray_files": 0 } }
      ]
    },
    {
      "id": "session/format-round-trips-byte-for-byte",
      "requirement": "The stored session is a contract shared between clients",
      "scenario": "A login in one client authenticates another",
      "given": {},
      "steps": [
        {
          "op": "round_trip",
          "raw": "{\n  \"endpoint\": \"https://jennah.alphaus.cloud\",\n  \"access_token\": \"eyJhbGciOiJIUzI1NiJ9.header.signature\",\n  \"refresh_token\": \"rt_opaque_value\",\n  \"token_type\": \"Bearer\",\n  \"expires_at\": 1786000000\n}",
          "expect": { "identical": true }
        }
      ]
    },
    {
      "id": "endpoint/stored-endpoint-is-not-adopted",
      "requirement": "A stored endpoint does not select a client's endpoint",
      "scenario": "A session stored by one front door's client does not redirect another",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_stored",
          "refresh_token": "rt_stored",
          "token_type": "Bearer",
          "expires_in": 3600
        }
      },
      "steps": [
        { "op": "construct", "endpoint": "default", "expect": { "ok": true } },
        { "op": "describe", "expect": { "endpoint": "$DEFAULT_ENDPOINT" } }
      ]
    },
    {
      "id": "expiry/unrenewable-expired-session-fails-construction",
      "requirement": "An expired session fails at resolution, not on first use",
      "scenario": "An obviously expired session names the fix",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "",
          "token_type": "Bearer",
          "expires_in": -60
        }
      },
      "steps": [
        { "op": "construct", "expect": { "error": ["session_expired"], "mentions": ["jnh login"] } }
      ]
    },
    {
      "id": "expiry/renewable-expired-session-constructs-and-renews",
      "requirement": "An expired session fails at resolution, not on first use",
      "scenario": "An obviously expired session names the fix",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "refreshes": 1, "presented": ["at_expired", "at_renewed"] } }
      ]
    },
    {
      "id": "expiry/unexpired-session-is-still-attempted-and-rejection-stands",
      "requirement": "An expired session fails at resolution, not on first use",
      "scenario": "The recorded expiry never overrides the platform",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_stored",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": 3600
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "refreshes": 1, "presented": ["at_stored", "at_renewed"] } }
      ]
    },
    {
      "id": "per-call/renewed-credential-is-presented-thereafter",
      "requirement": "The credential is resolved per call, not captured once",
      "scenario": "A renewed credential takes effect without reconnecting",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "call", "method": "write_unsafe", "expect": { "ok": true } },
        { "op": "check", "expect": { "refreshes": 1, "presented": ["at_expired", "at_renewed", "at_renewed", "at_renewed"] } }
      ]
    },
    {
      "id": "renewal/unsafe-write-renews-and-retries",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "A write with no replay evidence still renews and retries",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "write_unsafe", "expect": { "ok": true } },
        { "op": "check", "expect": { "refreshes": 1, "presented": ["at_expired", "at_renewed"] } }
      ]
    },
    {
      "id": "renewal/renewal-call-carries-no-bearer",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "An expired session renews mid-flight",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "refresh_bearers": [""] } }
      ]
    },
    {
      "id": "renewal/second-rejection-stops",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "A renewal that does not fix the rejection stops",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "reject_all": true,
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "error": ["unauthenticated"] } },
        { "op": "check", "expect": { "refreshes": 1, "presented": ["at_expired", "at_renewed"] } }
      ]
    },
    {
      "id": "renewal/refused-api-key-is-not-renewed",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "A rejected non-renewable credential fails immediately",
      "given": {
        "explicit": "jennah_sk_wrong",
        "server": {
          "reject_all": true,
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        {
          "op": "call",
          "method": "read",
          "expect": { "error": ["credential_refused", "unauthenticated"], "not": ["session_expired"] }
        },
        { "op": "check", "expect": { "refreshes": 0, "refresh_calls": 0, "presented": ["jennah_sk_wrong"] } }
      ]
    },
    {
      "id": "renewal/explicit-access-token-is-not-renewed",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "A rejected non-renewable credential fails immediately",
      "given": {
        "explicit": "eyJ.explicit.token",
        "server": {
          "reject_all": true,
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "error": ["unauthenticated"] } },
        { "op": "check", "expect": { "refresh_calls": 0, "presented": ["eyJ.explicit.token"] } }
      ]
    },
    {
      "id": "renewal/stored-session-without-refresh-token-names-login",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "A rejected non-renewable credential fails immediately",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_stored",
          "refresh_token": "",
          "token_type": "Bearer",
          "expires_in": 3600
        },
        "server": { "accept": "at_current" }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        {
          "op": "call",
          "method": "read",
          "expect": { "error": ["session_expired", "unauthenticated"], "mentions": ["jnh login"] }
        },
        { "op": "check", "expect": { "refresh_calls": 0 } }
      ]
    },
    {
      "id": "renewal/refused-renewal-reports-expired-session",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "A renewal that does not fix the rejection stops",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_stale",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_other", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "error": ["session_expired"], "mentions": ["jnh login"] } },
        { "op": "check", "expect": { "refreshes": 0, "refresh_calls": 1, "presented": ["at_expired"] } }
      ]
    },
    {
      "id": "write-back/rotated-session-is-published",
      "requirement": "A renewed session is published to the clients that share it",
      "scenario": "A renewal survives the process that performed it",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        {
          "op": "check",
          "expect": {
            "session": {
              "endpoint": "https://jennah.alphaus.cloud",
              "access_token": "at_renewed",
              "refresh_token": "rt_rotated",
              "token_type": "Bearer",
              "expires": "future"
            },
            "session_mode": "0600",
            "dir_mode": "0700",
            "stray_files": 0
          }
        }
      ]
    },
    {
      "id": "write-back/concurrent-rejections-renew-once",
      "requirement": "A renewed session is published to the clients that share it",
      "scenario": "Concurrent calls renew once",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call_concurrently", "method": "read", "count": 8, "expect": { "ok": true } },
        { "op": "check", "expect": { "refreshes": 1, "refresh_calls": 1 } }
      ]
    },
    {
      "id": "write-back/another-process-renewal-is-adopted-before-renewing",
      "requirement": "A renewed session is published to the clients that share it",
      "scenario": "Another process's renewal is discovered rather than fought",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_other",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        {
          "op": "write_session",
          "session": {
            "endpoint": "https://jennah.alphaus.cloud",
            "access_token": "at_other",
            "refresh_token": "rt_other",
            "token_type": "Bearer",
            "expires_in": 3600
          }
        },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "refresh_calls": 0, "presented": ["at_expired", "at_other"] } }
      ]
    },
    {
      "id": "write-back/another-process-renewal-is-adopted-after-a-failed-renewal",
      "requirement": "A renewed session is published to the clients that share it",
      "scenario": "Another process's renewal is discovered rather than fought",
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_other",
          "refresh": { "accept": "rt_raced_away", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 },
          "on_refresh_write_session": {
            "endpoint": "https://jennah.alphaus.cloud",
            "access_token": "at_other",
            "refresh_token": "rt_other",
            "token_type": "Bearer",
            "expires_in": 3600
          }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "refreshes": 0, "refresh_calls": 1, "presented": ["at_expired", "at_other"] } }
      ]
    },
    {
      "id": "write-back/unpersistable-renewal-is-surfaced",
      "requirement": "A renewed session is published to the clients that share it",
      "scenario": "A renewal survives the process that performed it",
      "requires": ["unwritable_directory"],
      "given": {
        "session": {
          "endpoint": "https://jennah.alphaus.cloud",
          "access_token": "at_expired",
          "refresh_token": "rt_valid",
          "token_type": "Bearer",
          "expires_in": -60
        },
        "server": {
          "accept": "at_current",
          "refresh": { "accept": "rt_valid", "access_token": "at_renewed", "refresh_token": "rt_rotated", "expires_in": 3600 }
        }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "lock_session_directory" },
        { "op": "call", "method": "read", "expect": { "error": ["failed"] } },
        { "op": "check", "expect": { "refreshes": 1 } }
      ]
    },
    {
      "id": "replay/unavailable-read-is-retried",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "A write with no replay evidence still renews and retries",
      "given": {
        "explicit": "jennah_sk_explicit",
        "server": { "accept": "jennah_sk_explicit", "unavailable_first": 1 }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "read", "expect": { "ok": true } },
        { "op": "check", "expect": { "presented": ["jennah_sk_explicit", "jennah_sk_explicit"] } }
      ]
    },
    {
      "id": "replay/unavailable-unsafe-write-is-not-retried",
      "requirement": "An authentication rejection renews a session once and retries",
      "scenario": "A write with no replay evidence still renews and retries",
      "given": {
        "explicit": "jennah_sk_explicit",
        "server": { "accept": "jennah_sk_explicit", "unavailable_first": 1 }
      },
      "steps": [
        { "op": "construct", "expect": { "ok": true } },
        { "op": "call", "method": "write_unsafe", "expect": { "error": ["unavailable"] } },
        { "op": "check", "expect": { "presented": ["jennah_sk_explicit"] } }
      ]
    }
  ]
}
